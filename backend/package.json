{
  "name": "urbannest-backend",
  "version": "1.0.0",
  "private": true,
  "description": "UrbanNest Secure REST API: Express + MongoDB with a from-scratch cryptographic core",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "create-admin": "node scripts/createAdmin.js",
    "migrate:property-ids": "node scripts/migrations/assignPropertyIds.js",
    "migrate:pii": "node scripts/migrations/migratePlaintext.js",
    "migrate:properties": "node scripts/migrations/migrateProperties.js",
    "migrate:email-index": "node scripts/migrations/fixIndexesForEmailFingerprint.js",
    "script:fingerprint": "node scripts/maintenance/findFingerprint.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.3.1",
    "helmet": "^7.1.0",
    "mongoose": "^8.24.1",
    "morgan": "^1.12.1",
    "nodemailer": "^10.0.14"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
