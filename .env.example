# ─── UrbanNest Secure — environment configuration ────────────────────────────
# Copy this file to `.env` (in the repository root) and fill in your values.
# The backend loads it from here regardless of the directory it is started in.

# Server
PORT=5000
NODE_ENV=development
# Public URL of the frontend, added to the CORS allow-list in production
CLIENT_URL=http://localhost:5173

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb://localhost:27017/urbannest

# SMTP account used to send OTP e-mails (Gmail requires an App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Administrator account
# - `npm run create-admin` creates this account (defaults: admin@gmail.com / admin123)
# - logging in with ADMIN_EMAIL promotes that account to the admin role
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Admin User
